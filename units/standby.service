[Unit]
Description=standby: holds the lease for this machine, or waits for it
After=network-online.target

[Service]
ExecStart=%h/.local/share/standby/standby run
ExecStopPost=-%h/.local/share/standby/standby fence
RuntimeDirectory=standby
# A restart keeps the held file, so the next run knows what still runs and renews its tenure.
RuntimeDirectoryPreserve=restart
Restart=always
RestartSec=2
# At most TTL/3: a standby that hangs is replaced, and renews, before its last renewal runs out.
WatchdogSec=20
NotifyAccess=all
WatchdogSignal=SIGKILL
# A machine going down stops what it holds and passes the lease on before standby exits.
TimeoutStopSec=5min

[Install]
WantedBy=default.target
