FROM docker.io/library/debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv dbus libpam-systemd sqlite3 nftables procps \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -u 1000 hex && mkdir -p /var/lib/systemd/linger /home/hex/.local/share/standby /home/hex/.config /home/hex/db \
 && touch /var/lib/systemd/linger/hex && chown -R hex:hex /home/hex
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
